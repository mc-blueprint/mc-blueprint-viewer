{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mc-blueprint/mc-blueprint/schema/scene.schema.json",
  "title": "mc-blueprint scene",
  "description": "scene v1。gzip 展開後の UTF-8 JSON。配列データのバイナリ表現と座標の契約は各プロパティの description を参照。",
  "type": "object",
  "required": ["formatVersion", "minecraftVersion", "engine", "source", "size", "origin", "palette", "chunks", "indexWidth", "sources", "blockEntities", "environment", "preview"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {"const": 1},
    "minecraftVersion": {"type": "string", "minLength": 1},
    "engine": {"$ref": "#/$defs/engine"},
    "source": {"$ref": "#/$defs/source"},
    "size": {"$ref": "#/$defs/size"},
    "origin": {"$ref": "#/$defs/vector"},
    "palette": {"type": "array", "minItems": 1, "prefixItems": [{"allOf": [{"$ref": "#/$defs/paletteEntry"}, {"type": "object", "required": ["state", "render"], "properties": {"state": {"const": "minecraft:air"}, "render": {"const": "invisible"}}}]}], "items": {"$ref": "#/$defs/paletteEntry"}, "description": "添字 0 は必ず minecraft:air（render: invisible）。範囲外や省略チャンクのブロックは 0 として扱う。"},
    "chunks": {"type": "array", "items": {"$ref": "#/$defs/chunk"}},
    "indexWidth": {"type": "integer", "enum": [16, 32], "description": "blocks 内の palette 添字のビット幅。palette の要素数が 65,536 を超える場合は 32、それ以外は 16。値はリトルエンディアン。"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/sourceEntry"}},
    "blockEntities": {"type": "array", "items": {"$ref": "#/$defs/blockEntity"}},
    "environment": {"$ref": "#/$defs/environment"},
    "preview": {"$ref": "#/$defs/preview"}
  },
  "$defs": {
    "vector": {"type": "array", "items": {"type": "integer"}, "minItems": 3, "maxItems": 3},
    "size": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 3, "maxItems": 3},
    "engine": {"type": "object", "required": ["version", "commit"], "additionalProperties": false, "properties": {"version": {"type": "string", "minLength": 1}, "commit": {"type": "string", "minLength": 1}}},
    "source": {"type": "object", "required": ["kind", "path", "sha256"], "additionalProperties": false, "properties": {"kind": {"enum": ["spec", "blueprint", "schematic"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$", "description": "入力（BuildSpec / Blueprint / schematic）の SHA-256。"}}},
    "paletteEntry": {"type": "object", "required": ["state", "render", "emission", "opacity", "tint"], "additionalProperties": false, "properties": {"state": {"type": "string", "minLength": 1}, "render": {"enum": ["model", "fluid", "entity", "invisible"]}, "emission": {"type": "integer", "minimum": 0, "maximum": 15}, "opacity": {"type": "integer", "minimum": 0, "maximum": 15}, "tint": {"enum": ["none", "grass", "foliage", "water", "fixed"]}, "tintColor": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3, "description": "tint: fixed の乗算色。blockdata の tints.fixed と同じ OKLab [L, a, b] 配列。"}}, "allOf": [{"if": {"properties": {"tint": {"const": "fixed"}}, "required": ["tint"]}, "then": {"required": ["tintColor"]}, "else": {"not": {"required": ["tintColor"]}}}]},
    "chunk": {"type": "object", "required": ["at", "blocks", "sources"], "additionalProperties": false, "properties": {"at": {"$ref": "#/$defs/vector", "description": "チャンクの最小コーナーの scene ローカル座標。チャンクは各軸 16 ブロック単位で分割し、scene 端のチャンクは scene 内にある実寸まで切り詰める。"}, "blocks": {"type": "string", "contentEncoding": "base64", "description": "base64 はチャンク内ブロックの palette 添字列を表す。添字は x を最速として (y × チャンク奥行 + z) × チャンク幅 + x の順に並べる。通常のチャンク幅・奥行は 16、端のチャンクでは切り詰め後の実寸を使う。値は indexWidth ビット幅の符号なし整数をリトルエンディアンで並べたバイト列。"}, "sources": {"type": "string", "contentEncoding": "base64", "description": "base64 は blocks と同じ並びの sources[].id 列を表す。各要素は符号なし uint32、リトルエンディアンで、端のチャンクでは切り詰め後の実寸分だけを格納する。0 は生成元不明。"}}},
    "sourceEntry": {"type": "object", "required": ["id"], "additionalProperties": false, "properties": {"id": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "element": {"type": "string"}, "spec": {"type": "string"}, "path": {"type": "string"}, "label": {"type": "string"}, "params": {"type": "array", "items": {"type": "string"}}}},
    "blockEntity": {"type": "object", "required": ["at", "id"], "additionalProperties": false, "properties": {"at": {"$ref": "#/$defs/vector"}, "id": {"type": "string", "minLength": 1}}},
    "oklabColor": {"type": "object", "required": ["l", "a", "b"], "additionalProperties": false, "properties": {"l": {"type": "number"}, "a": {"type": "number"}, "b": {"type": "number"}}},
    "environment": {"type": "object", "required": ["biome"], "additionalProperties": false, "properties": {"biome": {"type": "string", "minLength": 1}, "tints": {"type": "object", "description": "各 tint 種別に対応する OKLab の乗算色。grass・foliage・water は blockdata から取得したバイオーム色。", "required": ["grass", "foliage", "water"], "additionalProperties": false, "properties": {"grass": {"$ref": "#/$defs/oklabColor"}, "foliage": {"$ref": "#/$defs/oklabColor"}, "water": {"$ref": "#/$defs/oklabColor"}}}}},
    "preview": {"type": "object", "required": ["enabled", "shader", "shadows", "brightness", "timeOfDay", "blockLight", "quality"], "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "shader": {"enum": ["vanilla", "soft", "cinematic"]}, "shadows": {"type": "boolean"}, "brightness": {"type": "number", "minimum": 0, "maximum": 1}, "timeOfDay": {"type": "integer", "minimum": 0, "maximum": 23999}, "blockLight": {"type": "boolean"}, "quality": {"enum": ["auto", "low", "medium", "high"]}}}
  }
}
